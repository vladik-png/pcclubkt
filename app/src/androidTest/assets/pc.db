create table Games (
GameID int auto_increment primary key,
ComputerID int,
GameName TEXT not null,
Description TEXT null,
New boolean not null
default 0,
Top boolean not null
default 0,
foreign key (ComputerID) references Computers(ComputerID)
);
insert into Games (ComputerID,GameName,Description,New,Top)
values
(1, 'Assassin's Creed® Origins', 'The Discovery Tour by Assassin''s Creed®: Ancient Egypt is available now as a free update! Ancient Egypt, a land of majesty and intrigue, is disappearing in a ruthless fight for power.', 1, 0),
(2, 'Grand Theft Auto V', 'Grand Theft Auto V для ПК — це шанс заново відчути атмосферу славного міста Лос-Сантос і відправитись округ Blaine County', 0, 1),
(3, 'Assassin's Creed® Odyssey', 'Choose your fate in Assassin''s Creed® Odyssey. From outcast to living legend, embark on an odyssey to uncover the secrets of your past and change the fate of Ancient Greece.', 0, 0),
(4, 'BioShock™ Remastered', 'BioShock is a shooter unlike any other, loaded with unique weapons and tactics. Complete with an arsenal of revolvers, shotguns, and grenade launchers.', 0, 0),
(5, 'BioShock™ 2 Remastered', 'In BioShock 2, you step into the boots of the most iconic denizen of Rapture, the Big Daddy, as you explore through the decrepit and beautiful fallen city.', 0, 0),
(6, 'BioShock Infinite', 'Indebted to the wrong people, with his life on the line, veteran of the U.S. Cavalry and your hired gun, Booker DeWitt has only one opportunity to wipe his slate clean.', 0, 0),
(7, 'Dota 2', 'Щорічні мільйонні призи в цьому культовому у біді за одного з пізніх героїв Dota. І менше значення, буде із 10-ти годин гри на 1000- назавжди зізнається нове для відкриття.', 0, 1),
(8, 'Crash Bandicoot™ N. Sane Trilogy', 'Your favorite marsupial, Crash Bandicoot™, is back! He's enhanced, extended and ready-to-dance with the N. Sane Trilogy.', 0, 0),
(9, 'Cyberpunk 2077', 'Представляємо бойовик і ролівку раз з відкритим світом. Дій відбувається у темному майбутньому Haйт-Сіті.', 0, 0),
(10, 'Call of Duty®: Black Ops 6', 'Продовження серії Black Ops з кінематографічною одиничною кампанією.', 1, 1),
(11, 'Black Myth: Wukong', 'Рольові бойовики за мотивами китайської міфології.', 1, 1),
(12, 'Kingdom Come: Deliverance', 'Сочинена ролева в історії свій ігри, яка закручує нас у «певну» пригоду на території Священної Римської імперії.', 0, 0),
(13, 'Kingdom Come: Deliverance II', 'Заключена динамічна рольова гра з багатьма сюжетами, в якій події розгортаються в Європі 15 століття.', 1, 0);
